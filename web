            if (answer.style.display === "block") {
                answer.style.display = "none";
                span.textContent = "+";
            } else {
                answer.style.display = "block";
                span.textContent = "-";
            }
        }

        // Calculadora Interactiva de ROI
        function updateCalc() {
            const autos = document.getElementById('autos-slider').value;
            const precio = document.getElementById('precio-slider').value;
            
            document.getElementById('autos-val').innerText = autos;
            document.getElementById('precio-val').innerText = '$' + precio;

            // Estimación: 20% de clientes vuelven por service de mantenimiento anual
            const retornoEstimado = Math.round(autos * 12 * 0.20 * (precio * 0.6));
            document.getElementById('roi-result').innerText = '+$' + retornoEstimado.toLocaleString() + ' USD';
        }
